{
  "name": "otel-php-rust (PHP 7.4)",
  "dockerComposeFile": [
    "../compose.base.yaml",
    "compose.yaml"
  ],
  "service": "php",
  "runServices": [
    "php",
    "collector"
  ],
  "initializeCommand": ".devcontainer/build-image.sh 7.4",
  "workspaceFolder": "/workspace/otel",
  "remoteUser": "php-rust",
  "postStartCommand": "/workspace/.devcontainer/setup-signing-key.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "bmewburn.vscode-intelephense-client",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "rust-analyzer.cargo.features": [
          "test"
        ],
        "rust-analyzer.check.command": "clippy",
        // clippy reports far more warnings than errors here, and the Problems
        // panel sorts by file position by default, which buries the errors
        // among them. Sort by severity so deny-level lints come first.
        "problems.sortOrder": "severity",
        "rust-analyzer.linkedProjects": [
          "/workspace/otel/Cargo.toml"
        ],
        "terminal.integrated.defaultProfile.linux": "bash",
        // the repository root is /workspace but this folder is /workspace/otel,
        // so without this the git extension only offers to open the parent repo
        // behind a prompt, and shows no source control until you accept it
        "git.openRepositoryInParentFolders": "always",
        "php.validate.executablePath": "/usr/bin/php",
        "files.associations": {
          "*.phpt": "php"
        },
        "intelephense.files.exclude": [
          "**/tests/**/*.phpt"
        ]
      }
    }
  }
}
