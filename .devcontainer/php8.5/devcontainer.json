{
  "name": "otel-php-rust (PHP 8.5)",
  "dockerComposeFile": [
    "../compose.base.yaml",
    "compose.yaml"
  ],
  "service": "php",
  "runServices": [
    "php",
    "collector"
  ],
  "initializeCommand": ".devcontainer/build-image.sh 8.5",
  // the whole repository, not just otel/. The Cargo workspace is one level
  // down, but opening the root is what makes the committed .vscode/,
  // .github/, the top-level Makefile and CONTRIBUTING.md visible and
  // editable, and it puts the git repository at the workspace root rather
  // than above it. Shells and tasks still start in otel/ -- see
  // terminal.integrated.cwd below and .vscode/tasks.json.
  "workspaceFolder": "/workspace",
  "remoteUser": "php-rust",
  // an absolute path rather than a relative one: lifecycle commands run
  // from workspaceFolder, but that is only a "should" in the spec and the
  // reference implementation falls back to the home folder
  "postStartCommand": "${containerWorkspaceFolder}/.devcontainer/setup-signing-key.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "bmewburn.vscode-intelephense-client",
        "ms-azuretools.vscode-docker"
      ],
      // Only container-specific settings belong here. Everything portable
      // (rust-analyzer, .phpt handling, Problems sorting) is in the
      // repository's own .vscode/settings.json, which is committed and now
      // read by VS Code because the workspace opens at the repository root.
      "settings": {
        // VS Code always spawns the shell with an explicit cwd -- the
        // compose service's working_dir is never consulted -- so without
        // this every terminal would open at /workspace, one level above the
        // Makefile and Cargo.toml.
        "terminal.integrated.cwd": "${containerWorkspaceFolder}/otel",
        "terminal.integrated.defaultProfile.linux": "bash",
        "php.validate.executablePath": "/usr/bin/php"
      }
    }
  }
}
