              "kind": "file",
              "regexp": "\\b(FAIL|BORK|LEAK)\\s+(.*?)\\s+\\[([^\\]]+\\.phpt)\\]\\s*$",
              "message": 2,
              "file": 3
            }
          ]
        }
      ]
    },
    {
      "label": "test: JUnit report",
      "detail": "write a JUnit XML report of every suite to otel/junit.xml",
      "type": "shell",
      "command": "make build-test && TEST_PHP_JUNIT=junit.xml php run-tests.php -q tests/phpt/ tests/auto/ tests/otlp/ tests/http/",
      "group": "test",
      "problemMatcher": [
        {
          "owner": "phpt",
          "source": "run-tests.php",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": [
