              // run-tests.php reports a whole-file verdict, not a line number.
              "kind": "file",
              "regexp": "\\b(FAIL|BORK|LEAK)\\s+(.*?)\\s+\\[([^\\]]+\\.phpt)\\]\\s*$",
              "message": 2,
              "file": 3
            }
          ]
        }
      ]
    },
    {
      "label": "test: current phpt file",
      "detail": "run just the .phpt file open in the editor",
      "type": "shell",
      "command": "php run-tests.php -q --show-diff '${relativeFile}'",
      "group": "test",
      "problemMatcher": [
        {
          "owner": "phpt",
          "source": "run-tests.php",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": [
            {
              // run-tests.php prints "TEST n/m [file]\r" before the verdict, so
