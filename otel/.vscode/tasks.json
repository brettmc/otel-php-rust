              "kind": "file",
              "regexp": "\\b(FAIL|BORK|LEAK)\\s+(.*?)\\s+\\[([^\\]]+\\.phpt)\\]\\s*$",
              "message": 2,
              "file": 3
            }
          ]
        }
      ]
    },
    {
      "label": "test: otlp export",
      "detail": "tests/otlp \u2014 exports to the `collector` service over grpc + http/protobuf",
      "type": "shell",
      "command": "make test-export",
      "group": "test",
      "problemMatcher": [
        {
          "owner": "phpt",
          "source": "run-tests.php",
