        }
      ]
    },
    {
      "label": "test: everything",
      "detail": "phpt, auto-instrumentation, otlp and http suites in one run-tests.php invocation",
      "type": "shell",
      "command": "make build-test && php run-tests.php -q --show-diff tests/phpt/ tests/auto/ tests/otlp/ tests/http/",
      "group": "test",
      "problemMatcher": [
        {
          "owner": "phpt",
          "source": "run-tests.php",
          "fileLocation": [
            "relative",
