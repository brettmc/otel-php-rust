{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      // run-tests.php colourises FAIL/PASS; the escape codes stop the
      // phpt problem matcher below from recognising the line
      "NO_COLOR": "1"
    }
  },
  "presentation": {
    "echo": true,
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": "cargo: check",
      "detail": "cargo check, without building the extension",
      "type": "shell",
      "command": "make check",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "cargo: clippy",
      "detail": "clippy over lib + tests — lists what the editor only underlines",
      "type": "shell",
      "command": "make clippy",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "build: extension (debug)",
      "detail": "phpize + cargo build --features test, then copy to modules/otel.so",
      "type": "shell",
      "command": "make build-test",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "build: extension (release)",
      "detail": "cargo build --release",
      "type": "shell",
      "command": "make build",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "test: cargo + phpt",
      "detail": "cargo test, then the phpt suite (make test)",
      "type": "shell",
      "command": "make test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc",
        {
          "owner": "phpt",
          "source": "run-tests.php",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": [
            {
              // run-tests.php prints "TEST n/m [file]\r" before the verdict, so
              // FAIL lands mid-line on the same physical line -- hence \b, not ^.
              // kind:"file" is required because there is no line/location group:
              // run-tests.php reports a whole-file verdict, not a line number.
              "kind": "file",
              "regexp": "\\b(FAIL|BORK|LEAK)\\s+(.*?)\\s+\\[([^\\]]+\\.phpt)\\]\\s*$",
              "message": 2,
              "file": 3
            }
          ]
        }
      ]
    },
    {
      "label": "test: phpt",
      "detail": "phpt tests only, with diffs",
      "type": "shell",
      "command": "make test-phpt",
      "group": "test",
      "problemMatcher": [
        {
          "owner": "phpt",
          "source": "run-tests.php",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": [
            {
              // run-tests.php prints "TEST n/m [file]\r" before the verdict, so
              // FAIL lands mid-line on the same physical line -- hence \b, not ^.
              // kind:"file" is required because there is no line/location group:
              // run-tests.php reports a whole-file verdict, not a line number.
              "kind": "file",
              "regexp": "\\b(FAIL|BORK|LEAK)\\s+(.*?)\\s+\\[([^\\]]+\\.phpt)\\]\\s*$",
              "message": 2,
              "file": 3
            }
          ]
        }
      ]
    },
    {
      "label": "test: auto-instrumentation",
      "detail": "tests/auto \u2014 run 'composer: update test fixtures' once first",
      "type": "shell",
      "command": "make test-auto",
      "group": "test",
      "problemMatcher": [
        {
          "owner": "phpt",
          "source": "run-tests.php",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": [
            {
              // run-tests.php prints "TEST n/m [file]\r" before the verdict, so
