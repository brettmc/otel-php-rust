              "kind": "file",
              "regexp": "\\b(FAIL|BORK|LEAK)\\s+(.*?)\\s+\\[([^\\]]+\\.phpt)\\]\\s*$",
              "message": 2,
              "file": 3
            }
          ]
        }
      ]
    },
    {
      "label": "composer: update test fixtures",
      "detail": "composer update for the laminas, zf1 and psr18 test applications",
      "type": "shell",
      "command": "make update",
      "problemMatcher": []
    },
    {
      "label": "extension info (--ri)",
      "detail": "build, then print the extension's runtime info",
      "type": "shell",
      "command": "make ri",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "extension reflection (--re)",
      "detail": "build, then print the classes/functions the extension registers",
      "type": "shell",
      "command": "make re",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "clean",
      "detail": "empty target/ + remove phpize output and composer fixtures",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    },
    {
      "label": "clean, build and test everything",
      "detail": "make clean-build-test — full rebuild from scratch, then every suite",
      "type": "shell",
      "command": "make clean-build-test",
      "group": "test",
      "problemMatcher": [
        "$rustc",
        {
          "owner": "phpt",
          "source": "run-tests.php",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": [
            {
              // run-tests.php prints "TEST n/m [file]\r" before the verdict, so
